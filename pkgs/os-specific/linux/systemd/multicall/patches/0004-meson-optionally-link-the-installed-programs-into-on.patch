@@ -2385,6 +2394,23 @@ foreach dict : executables
                 error('Unknown install mode "@0@" for target "@1@"'.format(install, name))
         endif
 
+        # With multicall-binary, an installed program is neither linked nor installed by itself: its objects
+        # go into systemd-multicall, and a symlink to that takes its place. A program left out of
+        # multicall-programs is not installed at all, except udev's helpers, which the installed udev rules run.
