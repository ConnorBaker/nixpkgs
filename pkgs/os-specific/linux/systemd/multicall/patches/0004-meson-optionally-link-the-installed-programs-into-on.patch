                 name_shared,
                 sources : exe_sources,
@@ -2438,6 +2464,18 @@ foreach dict : executables
                         'link_args' : dict.get('link_args_static', kwargs.get('link_args', [])),
                 }
 
+                if in_multicall
+                        multicall_programs += {
+                                'name' : name,
+                                'install_dir' : install_dir,
+                                'sources' : exe_sources,
+                                'objects' : kwargs_static['objects'],
+                                'link_with' : link_with_static,
+                                'link_args' : kwargs_static['link_args'],
+                                'dependencies' : kwargs.get('dependencies', []),
+                        }
+                endif
+
                 exe_static = executable(
                         name_static,
                         kwargs : kwargs_static,
@@ -2520,6 +2558,46 @@ endforeach
 
 alias_target('fuzzers', fuzzer_exes)
 
+if want_multicall
+        objcopy = find_program('objcopy')
+        multicall_objects = []
+        multicall_args = []
+        multicall_link_with = []
+        multicall_link_args = []
+        multicall_dependencies = []
+        foreach p : multicall_programs
+                symbol = 'sd_main_' + p['name'].underscorify()
+                multicall_objects += custom_target(
+                        input : p['objects'],
+                        output : p['name'] + '.multicall.o',
+                        command : [multicall_relink_py, '@OUTPUT@', symbol, objcopy,
+                                   get_option('b_lto') ? '--lto' : '--no-lto',
+                                   cc.cmd_array(), '--', '@INPUT@'])
+                multicall_args += ['--program', p['name'], symbol, p['sources']]
+                multicall_link_with += p['link_with']
+                multicall_link_args += p['link_args']
+                multicall_dependencies += p['dependencies']
+
+                install_symlink(p['name'],
+                                pointing_to : fs.relative_to(libexecdir / 'systemd-multicall', p['install_dir']),
+                                install_dir : p['install_dir'])
+        endforeach
+
+        multicall_dispatch_c = custom_target(
+                output : 'multicall-dispatch.c',
+                command : [generate_multicall_dispatch_py, '@OUTPUT@', multicall_args])
+
+        executable(
+                'systemd-multicall',
+                multicall_dispatch_c,
+                objects : multicall_objects,
+                link_with : multicall_link_with,
+                link_args : multicall_link_args,
+                dependencies : [multicall_dependencies, userspace],
+                install : true,
+                install_dir : libexecdir)
+endif
+
 #####################################################################
 
 test_dlopen = executables_by_name.get('test-dlopen')
