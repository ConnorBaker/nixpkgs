diff --git a/tools/multicall-relink.py b/tools/multicall-relink.py
new file mode 100755
index 0000000000..22010745de
--- /dev/null
+++ b/tools/multicall-relink.py
@@ -0,0 +1,37 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: LGPL-2.1-or-later
+#
+# Partially link one program's objects into a single object for the multicall binary. Its main() is
+# renamed to the given symbol, and every other symbol it defines is made local, so that programs cannot
+# collide with each other. The __sd_dlopen_anchor_* symbols stay global: they belong to COMDAT groups that
+# are meant to be merged across the whole link.
+
+import subprocess
+import sys
+
+output, symbol, objcopy, lto, *rest = sys.argv[1:]
+sep = rest.index('--')
+cc, objects = rest[:sep], rest[sep + 1:]
+
+if lto == '--lto':
+    # Code-generate the program's LTO bytecode into a regular relocatable object, whose symbols can be renamed.
+    lto_args = ['-flto=auto', '-flinker-output=nolto-rel']
+else:
+    lto_args = ['-fno-lto']
+
+subprocess.run([*cc, '-r', '-nostdlib', *lto_args, '-o', output, *objects], check=True)
+# A program walks its options, verbs and static destructors from __start_X to __stop_X, which the final link
+# defines around section X: were X shared, the program would walk every program's entries. Its references are
+# still undefined here, and so can follow X to a section of the program's own, X_<program>. The libraries'
+# entries, which library code walks, keep the shared sections, as does SYSTEMD_BUS_ERROR_MAP, which is meant
+# to be shared.
+program = symbol.removeprefix('sd_main_')
+registries = [f'--{option}={prefix}{x}={prefix}{x}_{program}'
+              for x in ('SYSTEMD_OPTIONS', 'SYSTEMD_VERBS', 'SYSTEMD_STATIC_DESTRUCT')
+              for option, prefix in (('rename-section', ''), ('redefine-sym', '__start_'),
+                                     ('redefine-sym', '__stop_'))]
+# The bytecode of fat LTO objects would be carried along under the original symbol names; drop it.
+subprocess.run([objcopy, *registries, f'--redefine-sym=main={symbol}', '--wildcard',
+                f'--keep-global-symbol={symbol}', '--keep-global-symbol=__sd_dlopen_anchor_*',
+                '--remove-section=.gnu.lto_*', '--remove-section=.gnu.debuglto_*', output],
+               check=True)
