diff --git a/tools/generate-multicall-dispatch.py b/tools/generate-multicall-dispatch.py
new file mode 100755
index 0000000000..683bab3607
--- /dev/null
+++ b/tools/generate-multicall-dispatch.py
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: LGPL-2.1-or-later
+#
+# Generate main() of the multicall binary: find the program by the name it was invoked as, following
+# argv[0]'s chain of symlinks (/usr/sbin/reboot -> systemctl -> systemd-multicall), and failing that by the
+# names programs recognize themselves as through invoked_as().
+
+import re
+import sys
+
+output, args = sys.argv[1], sys.argv[2:]
+programs = []  # (name, symbol, aliases)
+while args:
+    assert args[0] == '--program'
+    n = args.index('--program', 1) if '--program' in args[1:] else len(args)
+    name, symbol, *sources = args[1:n]
+    aliases = set()
+    for s in sources:
+        if s.endswith('.c'):
+            with open(s, errors='replace') as f:
+                aliases |= set(re.findall(r'invoked_as\(argv, "([^"]+)"\)', f.read()))
+    programs.append((name, symbol, sorted(aliases)))
+    args = args[n:]
+
+with open(output, 'w') as f:
+    f.write('#include <limits.h>\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\n')
+    f.writelines(f'int {s}(int, char *[]);\n' for _, s, _ in programs)
+    f.write('\ntypedef int (*main_t)(int, char *[]);\n'
+            'static const struct { const char *name; main_t main; } programs[] = {\n')
+    f.writelines(f'        {{ "{n}", {s} }},\n' for n, s, _ in programs)
+    f.write('}, aliases[] = {\n')
+    f.writelines(f'        {{ "{a}", {s} }},\n' for _, s, al in programs for a in al)
+    f.write('''};
+
+static const char *base(const char *path) {
+        const char *slash = strrchr(path, '/');
+        return slash ? slash + 1 : path;
+}
+
+static main_t program(const char *path) {
+        for (size_t i = 0; i < sizeof programs / sizeof programs[0]; i++)
+                if (strcmp(base(path), programs[i].name) == 0)
+                        return programs[i].main;
+        return NULL;
+}
+
+int main(int argc, char *argv[]) {
+        char path[PATH_MAX], target[PATH_MAX];
+        main_t m;
+
+        if (strchr(argv[0], '/') && strlen(argv[0]) < sizeof path) {
+                strcpy(path, argv[0]);
+                for (int i = 0; i < 40; i++) {
+                        if ((m = program(path)))
+                                return m(argc, argv);
+                        ssize_t n = readlink(path, target, sizeof target - 1);
+                        if (n < 0)
+                                break;
+                        target[n] = 0;
+                        char *slash = strrchr(path, '/');
+                        if (target[0] == '/')
+                                strcpy(path, target);
+                        else if (slash && (size_t) (slash + 1 - path) + (size_t) n < sizeof path)
+                                strcpy(slash + 1, target);
+                        else
+                                break;
+                }
+        }
+        if ((m = program(argv[0])))
+                return m(argc, argv);
+        for (size_t i = 0; i < sizeof aliases / sizeof aliases[0]; i++)
+                if (strstr(base(argv[0]), aliases[i].name))
+                        return aliases[i].main(argc, argv);
+        fprintf(stderr, "%s: not a program of this multicall binary\\n", base(argv[0]));
+        return 127;
+}
+''')
