diff --git a/src/libc/musl/signal.c b/src/libc/musl/signal.c
new file mode 100644
index 0000000000..974d365a25
--- /dev/null
+++ b/src/libc/musl/signal.c
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <signal.h>
+#include <stdlib.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+/* musl's raise() and abort() send the signal to the TID cached in the thread descriptor, which only its own
+ * fork() and pthread_create() update (see missing_gettid()). In a child made with the clone() system call
+ * (raw_clone()), that is the parent's TID: the child's raise() would signal its parent, and its abort()
+ * would send SIGABRT to its parent before crashing itself. These look the IDs up with the system calls. */
+
+int missing_raise(int sig) {
+        sigset_t all, saved;
+        int r;
+
+        /* As musl does: no signal handler may run between looking up the IDs and sending the signal. */
+        (void) sigfillset(&all);
+        (void) sigprocmask(SIG_BLOCK, &all, &saved);
+        r = syscall(__NR_tgkill, getpid(), gettid(), sig);
+        (void) sigprocmask(SIG_SETMASK, &saved, NULL);
+        return r;
+}
+
+_Noreturn void missing_abort(void) {
+        sigset_t all, abrt;
+
+        (void) missing_raise(SIGABRT);
+
+        /* SIGABRT was caught and its handler returned, or it is blocked or ignored: as musl's abort() does,
+         * raise it again with the default action and unblocked, and failing that, end the process. */
+        (void) sigfillset(&all);
+        (void) sigprocmask(SIG_BLOCK, &all, NULL);
+        (void) sigaction(SIGABRT, &(const struct sigaction) { .sa_handler = SIG_DFL }, NULL);
+        (void) syscall(__NR_tgkill, getpid(), gettid(), SIGABRT);
+        (void) sigemptyset(&abrt);
+        (void) sigaddset(&abrt, SIGABRT);
+        (void) sigprocmask(SIG_UNBLOCK, &abrt, NULL);
+        (void) syscall(__NR_tgkill, getpid(), gettid(), SIGKILL);
+        _exit(127);
+}
diff --git a/src/libc/musl/unistd.c b/src/libc/musl/unistd.c
index 354fb5d016..cc61f873f7 100644
--- a/src/libc/musl/unistd.c
+++ b/src/libc/musl/unistd.c
@@ -13,3 +13,10 @@ int missing_close_range(unsigned first_fd, unsigned end_fd, unsigned flags) {
 int missing_execveat(int dirfd, const char *pathname, char * const argv[], char * const envp[], int flags) {
         return syscall(__NR_execveat, dirfd, pathname, argv, envp, flags);
 }
+
+pid_t missing_gettid(void) {
+        /* musl returns the TID it cached in the thread descriptor, which only its own fork() and
+         * pthread_create() update. In a child made with the clone() system call (raw_clone()) it would be
+         * the parent's TID, and is_main_thread() would be false in the child's only thread. */
+        return (pid_t) syscall(__NR_gettid);
+}
